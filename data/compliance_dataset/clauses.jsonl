{"standard_id": "BIS-STD-001", "standard_number": "IS 14543:2024", "clause_id": "IS_14543_2024_CL_1_1", "clause_number": "1.1", "clause_title": "Scope of Packaged Drinking Water", "requirement_text": "This standard prescribes requirements and methods of sampling and test for packaged drinking water other than packaged natural mineral water intended for direct human consumption.", "requirement_type": "PRODUCT_REQUIREMENT", "mandatory_language": "prescribes requirements", "applicability_condition": "All sealed, packaged potable water containers excluding natural mineral water.", "test_method": "Visual and Sensory", "parameter": "Scope conformity", "unit": "N/A", "limit": "Within scope", "tolerance": "None", "source_page": 1, "source_document": "IS_14543.pdf", "source_hash": "ece9fcd575946b3515421bb548cf90d2222b54d44da3cdbce87e2dd133caf63a", "source_metadata": {"source_id": "SRC-IS_14543_2024_CL_1_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 14543:2024", "clause": "1.1", "page": "1", "sha256": "ece9fcd575946b3515421bb548cf90d2222b54d44da3cdbce87e2dd133caf63a", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-001", "standard_number": "IS 14543:2024", "clause_id": "IS_14543_2024_CL_5_1", "clause_number": "5.1", "clause_title": "Total Dissolved Solids (TDS)", "requirement_text": "The total dissolved solids (TDS) of packaged drinking water shall not exceed 500 mg/l when tested in accordance with IS 3025 (Part 16).", "requirement_type": "PRODUCT_REQUIREMENT", "mandatory_language": "shall not exceed", "applicability_condition": "Finished water sample at 27 deg C.", "test_method": "IS 3025 (Part 16)", "parameter": "Total Dissolved Solids", "unit": "mg/l", "limit": "<= 500", "tolerance": "None", "source_page": 4, "source_document": "IS_14543.pdf", "source_hash": "e26b06ac840a729ddf5f3ffc2f578371e97f77c9449a88f9dc7ee05cebc4995e", "source_metadata": {"source_id": "SRC-IS_14543_2024_CL_5_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 14543:2024", "clause": "5.1", "page": "4", "sha256": "e26b06ac840a729ddf5f3ffc2f578371e97f77c9449a88f9dc7ee05cebc4995e", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-001", "standard_number": "IS 14543:2024", "clause_id": "IS_14543_2024_CL_5_2", "clause_number": "5.2", "clause_title": "Microbiological Requirements", "requirement_text": "Escherichia coli and coliform bacteria shall be absent in any 250 ml sample when tested according to IS 15185.", "requirement_type": "SAFETY_REQUIREMENT", "mandatory_language": "shall be absent", "applicability_condition": "Any retail or production container.", "test_method": "IS 15185", "parameter": "E. coli count", "unit": "CFU/250ml", "limit": "0", "tolerance": "Strict zero", "source_page": 5, "source_document": "IS_14543.pdf", "source_hash": "374b1c69ecb3c847dfb23897171c1f8c824320e32e21c9e1071ddd5dfad8ff89", "source_metadata": {"source_id": "SRC-IS_14543_2024_CL_5_2", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 14543:2024", "clause": "5.2", "page": "5", "sha256": "374b1c69ecb3c847dfb23897171c1f8c824320e32e21c9e1071ddd5dfad8ff89", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-001", "standard_number": "IS 14543:2024", "clause_id": "IS_14543_2024_CL_7_1", "clause_number": "7.1", "clause_title": "Marking Requirements", "requirement_text": "Each container shall be clearly and indelibly marked with the Standard Mark (ISI mark), batch number, date of manufacture, best before date, and net volume.", "requirement_type": "MARKING_REQUIREMENT", "mandatory_language": "shall be clearly and indelibly marked", "applicability_condition": "Container label or embossed body.", "test_method": "Visual inspection per Clause 7", "parameter": "Mandatory markings", "unit": "Boolean", "limit": "All present", "tolerance": "None", "source_page": 8, "source_document": "IS_14543.pdf", "source_hash": "606e0e752743ce7616f1965b3dcb4a66b971dbc70839ea25bbc9f6bce52918a7", "source_metadata": {"source_id": "SRC-IS_14543_2024_CL_7_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 14543:2024", "clause": "7.1", "page": "8", "sha256": "606e0e752743ce7616f1965b3dcb4a66b971dbc70839ea25bbc9f6bce52918a7", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-051", "standard_number": "IS 17526:2021", "clause_id": "IS_17526_2021_CL_1", "clause_number": "1", "clause_title": "Scope", "requirement_text": "This standard specifies requirements for stainless steel vacuum flasks, bottles, and insulated containers designed to hold hot or cold beverages.", "requirement_type": "PRODUCT_REQUIREMENT", "mandatory_language": "specifies requirements", "applicability_condition": "Double-walled vacuum insulated containers from 300 ml to 2500 ml.", "test_method": "Visual and Dimensional per Section 1", "parameter": "Scope", "unit": "ml", "limit": "300 - 2500", "tolerance": "+/- 5%", "source_page": 1, "source_document": "IS_17526.pdf", "source_hash": "4b9a336063113be1191b9420f2847c82e89b6ba7c6ee4ce4f5e68158cdd69778", "source_metadata": {"source_id": "SRC-IS_17526_2021_CL_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 17526:2021", "clause": "1", "page": "1", "sha256": "4b9a336063113be1191b9420f2847c82e89b6ba7c6ee4ce4f5e68158cdd69778", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-051", "standard_number": "IS 17526:2021", "clause_id": "IS_17526_2021_CL_4_1", "clause_number": "4.1", "clause_title": "Material of Construction", "requirement_text": "The inner body in contact with food or beverages shall be fabricated from Austenitic stainless steel Grade SS 304 conforming to IS 6911.", "requirement_type": "MATERIAL_REQUIREMENT", "mandatory_language": "shall be fabricated", "applicability_condition": "All surfaces contacting stored beverage.", "test_method": "Spectrometry / Chemical analysis per IS 228", "parameter": "Chromium and Nickel content", "unit": "% wt", "limit": "Cr >= 17.5%, Ni >= 8.0%", "tolerance": "per IS 6911", "source_page": 2, "source_document": "IS_17526.pdf", "source_hash": "ff7c24e7fa6c3b92c25bf233ab8c3cf2e6900c5e3361dcb6ca2aab37841bf19f", "source_metadata": {"source_id": "SRC-IS_17526_2021_CL_4_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 17526:2021", "clause": "4.1", "page": "2", "sha256": "ff7c24e7fa6c3b92c25bf233ab8c3cf2e6900c5e3361dcb6ca2aab37841bf19f", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-051", "standard_number": "IS 17526:2021", "clause_id": "IS_17526_2021_CL_5_2", "clause_number": "5.2", "clause_title": "Thermal Insulation Performance", "requirement_text": "When filled with boiling water at 95 deg C and kept at room temperature (27 deg C), the water temperature shall not drop below 60 deg C after 6 hours (for flasks <= 1L) or 65 deg C (for flasks > 1L).", "requirement_type": "PERFORMANCE_REQUIREMENT", "mandatory_language": "shall not drop below", "applicability_condition": "Ambient 27 +/- 2 deg C.", "test_method": "Calibrated Thermocouple test per Clause 5.2", "parameter": "Water temperature after 6h", "unit": "deg C", "limit": ">= 60", "tolerance": "None", "source_page": 4, "source_document": "IS_17526.pdf", "source_hash": "777167a5268712c5a674e3de22af2e5738d132f7fa3e5aef136dd29509307950", "source_metadata": {"source_id": "SRC-IS_17526_2021_CL_5_2", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 17526:2021", "clause": "5.2", "page": "4", "sha256": "777167a5268712c5a674e3de22af2e5738d132f7fa3e5aef136dd29509307950", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-051", "standard_number": "IS 17526:2021", "clause_id": "IS_17526_2021_CL_7_1", "clause_number": "7.1", "clause_title": "Drop and Impact Test", "requirement_text": "The flask filled to nominal capacity shall withstand a free fall from a height of 1.0 m onto a hardwood block without leakage or loss of thermal insulation.", "requirement_type": "TEST_REQUIREMENT", "mandatory_language": "shall withstand", "applicability_condition": "Filled to nominal capacity with water at 20 deg C.", "test_method": "Free drop from 1.0 m per Clause 7.1", "parameter": "Leakage and insulation retention", "unit": "Boolean", "limit": "No leakage, vacuum intact", "tolerance": "Zero fracture", "source_page": 6, "source_document": "IS_17526.pdf", "source_hash": "8c591842cec8057164cfef96616e08196240f01558f969cdebf6fa5b73afea3b", "source_metadata": {"source_id": "SRC-IS_17526_2021_CL_7_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 17526:2021", "clause": "7.1", "page": "6", "sha256": "8c591842cec8057164cfef96616e08196240f01558f969cdebf6fa5b73afea3b", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-010", "standard_number": "IS 2347:2017", "clause_id": "IS_2347_2017_CL_1", "clause_number": "1", "clause_title": "Scope of Pressure Cookers", "requirement_text": "This standard specifies requirements for domestic pressure cookers having nominal capacities up to and including 22 litres.", "requirement_type": "PRODUCT_REQUIREMENT", "mandatory_language": "specifies requirements", "applicability_condition": "Domestic cookware <= 22 litres.", "test_method": "Capacity determination per Clause 3", "parameter": "Nominal capacity", "unit": "litres", "limit": "<= 22", "tolerance": "+/- 2%", "source_page": 1, "source_document": "IS_2347.pdf", "source_hash": "755a36ecbeb2f4c6b5f179b774eeb611a207d11a2a15c9435983ba059e314d84", "source_metadata": {"source_id": "SRC-IS_2347_2017_CL_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 2347:2017", "clause": "1", "page": "1", "sha256": "755a36ecbeb2f4c6b5f179b774eeb611a207d11a2a15c9435983ba059e314d84", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-010", "standard_number": "IS 2347:2017", "clause_id": "IS_2347_2017_CL_4_1", "clause_number": "4.1", "clause_title": "Materials of Body and Lid", "requirement_text": "The cooker body and lid shall be manufactured from aluminium alloy conforming to IS 21, or stainless steel conforming to IS 6911.", "requirement_type": "MATERIAL_REQUIREMENT", "mandatory_language": "shall be manufactured", "applicability_condition": "Body shell and lid.", "test_method": "Chemical analysis per IS 504 / IS 228", "parameter": "Material grade", "unit": "Composition", "limit": "IS 21 / IS 6911", "tolerance": "Standard", "source_page": 3, "source_document": "IS_2347.pdf", "source_hash": "6ceaee626a2890270671b1ede17015fe86297283e0603f4eba3abaef120923f8", "source_metadata": {"source_id": "SRC-IS_2347_2017_CL_4_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 2347:2017", "clause": "4.1", "page": "3", "sha256": "6ceaee626a2890270671b1ede17015fe86297283e0603f4eba3abaef120923f8", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-010", "standard_number": "IS 2347:2017", "clause_id": "IS_2347_2017_CL_5_4", "clause_number": "5.4", "clause_title": "Operating Pressure and Weight Valve", "requirement_text": "The pressure cooker shall operate smoothly at an operating pressure between 0.9 kgf/cm2 and 1.1 kgf/cm2 with automatic pressure release.", "requirement_type": "PERFORMANCE_REQUIREMENT", "mandatory_language": "shall operate smoothly", "applicability_condition": "Cooker assembled with standard weight valve.", "test_method": "Manometer pressure testing per Clause 5.4", "parameter": "Operating pressure", "unit": "kgf/cm2", "limit": "0.9 to 1.1", "tolerance": "None", "source_page": 4, "source_document": "IS_2347.pdf", "source_hash": "cab2ddca2939ced51221e3311f296f82e233e78ef32bcb7b64a16907b88e95ab", "source_metadata": {"source_id": "SRC-IS_2347_2017_CL_5_4", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 2347:2017", "clause": "5.4", "page": "4", "sha256": "cab2ddca2939ced51221e3311f296f82e233e78ef32bcb7b64a16907b88e95ab", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-010", "standard_number": "IS 2347:2017", "clause_id": "IS_2347_2017_CL_6_2", "clause_number": "6.2", "clause_title": "Hydraulic Burst Pressure Test", "requirement_text": "The pressure cooker shall withstand hydrostatic pressure of not less than 3 times the operating pressure (minimum 3.0 kgf/cm2) without rupture or catastrophic leakage.", "requirement_type": "SAFETY_REQUIREMENT", "mandatory_language": "shall withstand", "applicability_condition": "Safety valves plugged, hydrostatic pressure applied.", "test_method": "Hydrostatic pressure test rig per Clause 6.2", "parameter": "Burst pressure", "unit": "kgf/cm2", "limit": ">= 3.0", "tolerance": "None", "source_page": 6, "source_document": "IS_2347.pdf", "source_hash": "7326d658982f1b3385670f1c946ed1aef8a7e8b2dcd22db95b1e24f1acfe62c4", "source_metadata": {"source_id": "SRC-IS_2347_2017_CL_6_2", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 2347:2017", "clause": "6.2", "page": "6", "sha256": "7326d658982f1b3385670f1c946ed1aef8a7e8b2dcd22db95b1e24f1acfe62c4", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-009", "standard_number": "IS 302-2-3:2007", "clause_id": "IS_302-2-3_2007_CL_8_1", "clause_number": "8.1", "clause_title": "Protection Against Electric Shock", "requirement_text": "Live parts shall not be accessible to standard test finger per IEC 61032 under all normal operating conditions.", "requirement_type": "SAFETY_REQUIREMENT", "mandatory_language": "shall not be accessible", "applicability_condition": "Appliance fully assembled and ungrounded during probe check.", "test_method": "Test Probe B per IS 14003", "parameter": "Accessibility of live parts", "unit": "Boolean", "limit": "Inaccessible", "tolerance": "Zero tolerance", "source_page": 4, "source_document": "IS_302-2-3.pdf", "source_hash": "890ecc9ac5eacdccad545fc3c0c9cdb001661b2d73d0d81d18fe8219cc267f58", "source_metadata": {"source_id": "SRC-IS_302-2-3_2007_CL_8_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 302-2-3:2007", "clause": "8.1", "page": "4", "sha256": "890ecc9ac5eacdccad545fc3c0c9cdb001661b2d73d0d81d18fe8219cc267f58", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-009", "standard_number": "IS 302-2-3:2007", "clause_id": "IS_302-2-3_2007_CL_13_2", "clause_number": "13.2", "clause_title": "Leakage Current and Dielectric Strength", "requirement_text": "The leakage current of the appliance at operating temperature shall not exceed 0.75 mA.", "requirement_type": "SAFETY_REQUIREMENT", "mandatory_language": "shall not exceed", "applicability_condition": "Operating at 1.15 times rated input power.", "test_method": "Leakage current meter per Clause 13", "parameter": "Leakage current", "unit": "mA", "limit": "<= 0.75", "tolerance": "None", "source_page": 7, "source_document": "IS_302-2-3.pdf", "source_hash": "d574a9bb260139d76b75664b1737d252eb38a2b06d70c485cdb3aca2578e0dc8", "source_metadata": {"source_id": "SRC-IS_302-2-3_2007_CL_13_2", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 302-2-3:2007", "clause": "13.2", "page": "7", "sha256": "d574a9bb260139d76b75664b1737d252eb38a2b06d70c485cdb3aca2578e0dc8", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
{"standard_id": "BIS-STD-005", "standard_number": "IS 13252 (Part 1):2010", "clause_id": "IS_13252_(Part_1)_2010_CL_2_1_1", "clause_number": "2.1.1", "clause_title": "Protection in Operator Access Areas", "requirement_text": "Operator access areas shall be designed so that bare parts operating at hazardous voltage (SELV limit > 42.4V peak or 60V DC) are not touchable.", "requirement_type": "SAFETY_REQUIREMENT", "mandatory_language": "shall be designed", "applicability_condition": "IT equipment energized at 230V AC.", "test_method": "Jointed test finger probe per Clause 2.1.1.1", "parameter": "SELV barrier integrity", "unit": "Boolean", "limit": "Protected", "tolerance": "None", "source_page": 12, "source_document": "IS_13252_(Part_1).pdf", "source_hash": "d586ae7b8e35f3f47bf08b508e61c8d12bc9cc01568efc632688e5bc3e95a1dc", "source_metadata": {"source_id": "SRC-IS_13252_(Part_1)_2010_CL_2_1_1", "source_type": "VERIFIED_BIS_SOURCE", "issuing_body": "Bureau of Indian Standards", "document_name": "IS 13252 (Part 1):2010", "clause": "2.1.1", "page": "12", "sha256": "d586ae7b8e35f3f47bf08b508e61c8d12bc9cc01568efc632688e5bc3e95a1dc", "verification_status": "VERIFIED"}, "quality": "QUALITY_A", "requires_human_review": false, "review_reason": null}
