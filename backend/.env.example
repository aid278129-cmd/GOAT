# BIS Compliance Compiler - Backend Environment Variables
PROJECT_NAME="BIS Compliance Compiler"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & CORS
SECRET_KEY="zyntrix-development-secret-key-change-in-production"
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL + pgvector Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="bis_compliance_db"

# Storage Settings
STORAGE_LOCAL_PATH="./storage"
MAX_UPLOAD_SIZE_MB=25

# Logging
LOG_LEVEL="INFO"
