# ==============================================================================
# Zyntrix BIS Compliance Compiler — Portable Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="BIS Compliance Compiler"
PROJECT_TEAM="Zyntrix"
SIH_PROBLEM_ID="26107"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# Judge / Demo Mode (Set True for offline judge demo without external DB requirements)
DEMO_MODE=False

# Security & CORS
SECRET_KEY="zyntrix-development-secret-key-change-in-production"
ALLOWED_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Configuration
# Option A: Standard PostgreSQL with pgvector (recommended for production & Docker)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="bis_compliance_db"

# Option B: Direct DATABASE_URL (takes precedence if provided)
# For PostgreSQL: DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/bis_compliance_db"
# For SQLite (offline demo): DATABASE_URL="sqlite+aiosqlite:///./data/zyntrix.db"
# DATABASE_URL=""

# Storage and Directories (Defaults to project-relative paths)
STORAGE_LOCAL_PATH="./storage"
MAX_UPLOAD_SIZE_MB=25

# Logging
LOG_LEVEL="INFO"
